FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      snappyHexMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

#includeEtc     "caseDicts/mesh/generation/snappyHexMeshDict.cfg"
castellatedMesh on;

snap            on;

addLayers       on;

geometry
{
    ahmedBody
    {
        type            triSurface;
        file            "ahmedBody.stl";
        name            ahmedBody;
        regions
        {
            body
            {
                name            body;
            }
            legs
            {
                name            legs;
            }
        }
    }
    refinementBox
    {
        type            box;
        min             ( -0.2 0 -0.195 );
        max             ( 1.3 0.3 0.2 );
    }
}

castellatedMeshControls
{
    maxLocalCells   10000000;
    maxGlobalCells  8000000;
    minRefinementCells 10;
    maxLoadUnbalance 0.1;
    nCellsBetweenLevels 3;
    features        ( { file "ahmedBody.eMesh" ; level 4 ; } );
    refinementSurfaces
    {
        ahmedBody
        {
            level           ( 0 0 );
            regions
            {
                body
                {
                    level           ( 3 4 );
                    patchInfo
                    {
                        type            wall;
                        inGroups        ( walls );
                    }
                }
                legs
                {
                    level           ( 4 5 );
                    patchInfo
                    {
                        type            wall;
                        inGroups        ( walls );
                    }
                }
            }
        }
    }
    refinementRegions
    {
        refinementBox
        {
            mode            inside;
            level           3;
        }
    }
    insidePoint     ( -1.04142 0.0993608 -0.0248027 );
    nCellsBetweenLevels 5;
}

snapControls
{
    nSmoothPatch    2;
    tolerance       2;
    nSolveIter      30;
    nRelaxIter      5;
    nFeatureSnapIter 10;
    implicitFeatureSnap false;
    explicitFeatureSnap true;
    multiRegionFeatureSnap false;
}

addLayersControls
{
    layers
    {
        body
        {
            nSurfaceLayers  10;
            firstLayerThickness 1.89016e-05;
            expansionRatio  1.3;
        }
        legs
        {
            nSurfaceLayers  2;
            firstLayerThickness 1.89016e-05;
            expansionRatio  1.3;
        }
    }
    relativeSizes   off;
    nRelaxedIter    0;
    expansionRatio  1.3;
    minThickness    1.89e-06;
    maxThicknessToMedialRatio 0.8;
    firstLayerThickness 1.89016e-05;
    featureAngle    150;
    nSmoothThickness 20;
}

meshQualityControls
{
    minDeterminant  1e-06;
    minFaceWeight   0.0001;
    minVolRatio     0.0001;
    relaxed
    {
        maxNonOrtho     75;
        minDeterminant  1e-10;
        minTwist        -1;
        minVol          1e-20;
        minTetQuality   -1e+30;
    }
}

writeFlags      ( scalarLevels layerFields );

mergeTolerance  1e-06;



FoamFile
{
    format          ascii;
    class           dictionary;
    object          controlDict;
}

// U, k, omega, Aref, lRef ... are generated from case.inputs by Allrun.pre
#include        "${FOAM_CASE}/constant/caseSettings"

application     foamRun;
solver          incompressibleFluid;

startFrom       startTime;
startTime       0;
stopAt          endTime;
endTime         3000;          // SIMPLE iterations
deltaT          1;

writeControl    timeStep;
writeInterval   500;
purgeWrite      2;
writeFormat     ascii;
writePrecision  6;
timeFormat      general;
timePrecision   6;
runTimeModifiable true;

functions
{
    forceCoeffs
    {
        type            forceCoeffs;
        libs            ("libforces.so");
        patches         (body legs);
        rho             rhoInf;
        rhoInf          1;
        liftDir         (0 0 1);
        dragDir         (1 0 0);
        pitchAxis       (0 1 0);
        CofR            (0 0 0);
        magUInf         $magUInf;
        lRef            $lRef;
        Aref            $Aref;      // half-model frontal area (symmetry plane at y=0)
        writeControl    timeStep;
        writeInterval   1;
    }

    yPlus
    {
        type            yPlus;
        libs            ("libfieldFunctionObjects.so");
        writeControl    writeTime;
    }
}

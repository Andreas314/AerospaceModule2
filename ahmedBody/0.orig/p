FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0";
    object      p;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

#include        "${FOAM_CASE}/constant/caseSettings"

dimensions      [0 2 -2 0 0 0 0];

internalField   uniform $pressure;

boundaryField
{
    inlet 
    {
        type            fixedValue;
        value           unifor ($flowVelocity 0 0);
    }
    
    outlet
    {
        type            inletOutlet;
        inletValue      uniform (0 0 0);
    }

    ground
    {
        $inlet;
    }

    "(body|legs)"
    {
        type            noSlip;
    }

    freestream
    {
        type            freestreamVelocity;
        freestreamValue uniform ($flowVelocity 0 0);
    }

    processor
    {
        type            processor;
        value           uniform (0 0 0);
    }
}


#!/bin/bash
cd ${0%/*} || exit 1    # run from this directory

# Source tutorial run functions
. "$WM_PROJECT_DIR/bin/tools/RunFunctions"

usage () {
    exec 1>&2
    while [ "$#" -ge 1 ]; do echo "$1"; shift; done
    cat <<USAGE

Usage: ${0##*/} [OPTIONS]
options:
  -c | -cores <nCores>   number of cores in parallel run
  -h | -help             help
  -m | -mesh <S|M|L|XL>  mesh size
                         - S: small, 100k cells
                         - M: medium, 1 M cells (default)
                         - L: large, 4.5M cells

Runs the ${PWD##*/} simulation

USAGE
    exit 1
}


refineBackgroundMesh () {

    _nRefine="$1"
    _r=0
    while [ $_r -lt "$_nRefine" ]
    do
        echo "Refining the background mesh"
        runApplication -a refineMesh -overwrite
        _r=$(( _r + 1 ))
    done
}

setKeyword () {
    _entry="$1"
    _value="$2"
    _file="$3"

    foamDictionary -entry "$_entry" -set "$_value" "$_file" > /dev/null
}


#- you need to use nCores <= the available physical ones
maxCores="$(lscpu -p=Core,Socket | grep -v '^#' | sort -u | wc -l)"
nCores=$maxCores;
while [ "$#" -gt 0 ]
do
   case "$1" in
   -c | -cores)
      [ "$#" -ge 2 ] || usage "'$1' option requires an argument"
      nCores=$2
      if [ $nCores -gt $maxCores ]; then
	      echo "Not enough cores available" 
	      exit 1
      fi
      shift 2
      setKeyword numberOfSubdomains "$nCores" system/decomposeParDict
      ;;

   -h | -help)
      usage
      ;;

   -m | -mesh)
      [ "$#" -ge 2 ] || usage "'$1' option requires an argument"
      mesh=$2
      shift 2
      case "$mesh" in
          S)  nRefine=0;;
          M)  nRefine=1;;
          L)  nRefine=2;;
          *)  usage "Invalid argument '$mesh' to -m|-mesh <S|M|L>." ;;
      esac
      ;;
   -test)
      shift
      ;;
   -*)
      usage "Invalid option '$1'"
      ;;
   *)
      break
      ;;
    esac
done

nRefine=0;

[ ! -d 0 ] && cp -r 0.orig 0

#HERE CHANGE THE SETUPS FOR blockMESH 
#-----------------------------
#my OpenFOAM neither Opens or FOAMs without this command
source $HOME/OpenFOAM/OpenFOAM-14/etc/bashrc

#get the variables, we can make it better, but for now just sauce it
source ./variables.txt

#this changes the box and 
python3 make_background_box.py --stl constant/geometry/ahmedBody.stl \
        --upstream $sizeX1 --downstream $sizeX2 --lateral $sizeY --top $sizeZ2 --bottom $sizeZ1 \
        --cell-size $cellSize

#sed the grading in each direction
sed -E -i 's/simpleGrading \([0-9]+ [0-9]+ [0-9]+\)/simpleGrading ('$gradeX' '$gradeY' '$gradeZ')/g' system/blockMeshDict

#-----------------------------
runApplication blockMesh
runApplication surfaceFeatures
refineBackgroundMesh $nRefine;
setKeyword numberOfSubdomains "$nCores" system/decomposeParDict;
runApplication decomposePar -copyZero
#-----------------------------
#HERE WE PLAY WITH OUR SNAPPYS
#-----------------------------

#function to calculate the first layer thickness (as stated in the presentation aboot the turbulances)
calc_h1() {
    awk -v U="$1" -v L="$2" -v nu="$3" -v yp="$4" 'BEGIN {
        re = (U * L) / nu;
        if (re < 1e5) re = 1e5;
        cf = (2.0 * (log(re) / log(10)) - 0.65) ^ (-2.3);
        u_tau = U * sqrt(0.5 * cf);
        printf "%.6e\n", 2 * yp * nu / u_tau
    }'
}

viscosity=$(grep -E '^\s*nu\s+' constant/physicalProperties | awk '{print $NF}' | tr -d ';')
length=$(surfaceCheck constant/geometry/ahmedBody.stl 2>/dev/null \
  | awk -F'[()]' '/Bounding Box/ {split($2,a," "); split($4,b," "); print b[1]-a[1]}')

[ -z "$length" ] && { echo "Could not read body length"; exit 1; }
echo "nu=$viscosity  L=$length  U=$U  y+=$yplus"

h1=$(calc_h1 "$U" "$length" "$viscosity" "$yplus")
echo "The first layer thickness is $h1"

foamDictionary system/snappyHexMeshDict \
    -entry addLayersControls.firstLayerThickness -set "$h1"

foamDictionary system/snappyHexMeshDict -entry addLayersControls.minThickness \
    -set "$(awk -v h="$h1" 'BEGIN{printf "%.3e", 0.2*h}')"

foamDictionary system/snappyHexMeshDict \
    -entry addLayersControls.featureAngle -set "$featureAngle"

#-----------------------------
runParallel snappyHexMesh    
rm -rf cellLevel level0Edge pointLevel surfaceIndex \
   sets constant/extendedFeatureEdgeMesh
    
runParallel checkMesh

#This collects the grid data among the processors and creates a file, which can be plot with paraview
#-----------------------------
reconstructPar
touch grid.FOAM
grep -A12 "overall thickness" log.snappyHexMesh | tail -15
